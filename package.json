{
  "name": "goodfellow-plugin-gutenberg",
  "version": "0.2.1",
  "description": "A Goodfellow plugin that lets people edit pages in WordPress's block editor, Gutenberg, in place of Puck.",
  "keywords": [
    "goodfellow-plugin",
    "goodfellow",
    "gutenberg",
    "block-editor",
    "wordpress"
  ],
  "license": "GPL-2.0-or-later",
  "author": "Goodfellow contributors",
  "homepage": "https://github.com/goodfellow-cms/goodfellow-plugin-gutenberg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-plugin-gutenberg.git"
  },
  "bugs": "https://github.com/goodfellow-cms/goodfellow-plugin-gutenberg/issues",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/goodfellow-cms"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    }
  },
  "files": [
    "dist",
    "goodfellow-plugin.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:site": "node scripts/site-check.mjs",
    "build": "tsc -p tsconfig.build.json && cp src/*.css dist/ && node scripts/manifest.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/version.mjs"
  },
  "peerDependencies": {
    "@goodfellow-cms/core": ">=0.6.0 <1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@goodfellow-cms/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@tailwindcss/browser": "4.3.3",
    "@wordpress/block-editor": "19.0.0",
    "@wordpress/blocks": "17.0.0",
    "@wordpress/components": "43.0.0",
    "@wordpress/data": "11.0.0",
    "@wordpress/element": "10.0.0",
    "@wordpress/icons": "19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@goodfellow-cms/blocks": "0.7.0",
    "@goodfellow-cms/core": "0.7.0",
    "@goodfellow-cms/react": "0.7.0",
    "@puckeditor/core": "0.23.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "create-goodfellow": "0.7.0",
    "happy-dom": "21.0.4",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.9.1"
}
