{
  "name": "goodfellow-plugin-gutenberg",
  "version": "0.1.0",
  "description": "A Goodfellow plugin that lets people edit pages in WordPress's block editor, Gutenberg, in place of Puck.",
  "keywords": [
    "goodfellow-plugin",
    "goodfellow",
    "gutenberg",
    "block-editor",
    "wordpress"
  ],
  "license": "GPL-2.0-or-later",
  "author": "Goodfellow contributors",
  "homepage": "https://github.com/goodfellow-cms/goodfellow-plugin-gutenberg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-plugin-gutenberg.git"
  },
  "bugs": "https://github.com/goodfellow-cms/goodfellow-plugin-gutenberg/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    }
  },
  "files": [
    "dist",
    "goodfellow-plugin.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:site": "node scripts/site-check.mjs",
    "build": "tsc -p tsconfig.build.json && cp src/*.css dist/ && node scripts/manifest.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@goodfellow-cms/core": ">=0.6.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@goodfellow-cms/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@tailwindcss/browser": "4.3.3",
    "@wordpress/block-editor": "18.1.0",
    "@wordpress/blocks": "16.2.0",
    "@wordpress/components": "42.0.0",
    "@wordpress/data": "10.57.0",
    "@wordpress/element": "9.0.0",
    "@wordpress/icons": "18.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@goodfellow-cms/blocks": "0.6.0",
    "@goodfellow-cms/core": "0.6.0",
    "@goodfellow-cms/react": "0.6.0",
    "@puckeditor/core": "0.23.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "create-goodfellow": "0.6.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.9.1"
}
